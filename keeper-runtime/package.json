{
  "name": "keeper-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Off-chain keeper runtime that signs Stream-A TradeOnlyAgent EIP-712 delegations and submits them to venues.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsx --test test/*.test.ts",
    "example": "tsx scripts/run-example.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "elysium",
    "trade-only-agent",
    "delegation",
    "eip-712",
    "keeper"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ethers": "^6.13.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
