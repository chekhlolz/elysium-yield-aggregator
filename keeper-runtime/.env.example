# TradeOnlyAgent keeper runtime — environment template
#
# ⚠️  NEVER commit a real .env.
# ⚠️  NEVER use this file's default key for real funds.
#
# See SECURITY.md for the full policy. The private key below is the
# Hardhat dev account #0 and is safe to use against a local Anvil only.
# On any real chain it is worthless; on any public chain it is public
# knowledge and effectively burned.

# --- Chain ---
# HyperEVM testnet / local Anvil-HyperEVM use 999.
# For HyperEVM mainnet use 998.
CHAIN_ID=999

# JSON-RPC endpoint. Use localhost for Anvil-HyperEVM.
RPC_URL=http://127.0.0.1:8545

# --- Secrets ---
# NEVER commit a real .env. NEVER use this key for real funds.
# Hardhat dev account #0 — public, safe for local Anvil only.
# In production, source this from a KMS or hardware wallet instead.
KEEPER_PK=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# --- Addresses ---
# Delegator: the address whose delegations we sign on behalf of.
# Hardhat dev account #0 for local testing.
DELEGATOR_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# TradeOnlyAgent deployment address. Fill this in with the real
# deployed address of TradeOnlyAgent.sol on your chain.
# This value is the EIP-712 `verifyingContract`.
AGENT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# YieldAggregator address — optional, used by venue adapters.
AGGREGATOR_ADDRESS=

# --- Behaviour ---
# Polling interval for the venue loop, in milliseconds.
WATCH_INTERVAL_MS=1000

# Client-side rate limit, txs per minute. Hard cap; not a substitute
# for `revoke`. See SECURITY.md.
MAX_TXS_PER_MINUTE=60

# --- Venues ---
# Optional. Comma-separated list of venue adapter ids. Empty = mock
# venue only. Reserved for Phase 2+.
VENUES=
