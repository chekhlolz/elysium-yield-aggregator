# .env.example
#
# Hardhat / Anvil default dev key #0. NEVER use this for real funds.
# In production, use `ethers.Wallet.createRandom().privateKey` written to a
# file with mode 0600, or a KMS / hardware signer.
#
# Hardhat's built-in account list is public and reproducible — anyone who
# runs `anvil` with defaults has the same key. If this key ever touches a
# funded Elysium wallet, treat the funds as compromised immediately.

# JSON-RPC endpoint.
#   - Local dev:    http://127.0.0.1:8545   (anvil)
#   - Elysium L2:   https://<endpoint published by Kinetiq>
# Elysium RPC is not published yet; use CHAIN_ID=999 + a local Anvil fork
# for local development.
RPC_URL=http://127.0.0.1:8545

# Deployer private key (Hardhat dev key #0 — DEV ONLY).
DEPLOYER_PK=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Chain id. Placeholder until Kinetiq publishes the final value.
# 999 is the anvil default; match whatever your local fork is using.
CHAIN_ID=999

# Optional: HYPE token address on Elysium. When not set, the client
# deploys against whatever HYPE address your local fork pre-deploys
# (Anvil: 0x0000000000000000000000000000000000001010 by default, or
# override with a MockERC20 for the vault tests).
# HYPE_ADDRESS=0x...
